# VITE_付きはフロント公開の可能性あり
# Access KeyにはVITE_を付けない

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_RAKUTEN_APPLICATION_ID=
VITE_RAKUTEN_AFFILIATE_ID=

RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=

# Chrome拡張から /api/assets-import を呼ぶ場合に許可するOrigin
# 例: chrome-extension://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ASSET_IMPORT_ALLOWED_ORIGINS=

# Cloudflare Image Resizingを有効化している場合だけtrue
ASSET_IMPORT_ENABLE_CLOUDFLARE_IMAGE_RESIZING=false
