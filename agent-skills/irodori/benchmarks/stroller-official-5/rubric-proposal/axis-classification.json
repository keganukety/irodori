{
  "schema_version": "1.0.0",
  "proposal_id": "stroller-train-commute-axis-classification-v1",
  "status": "proposed",
  "applies_to_real_products": false,
  "unknown_policy": "null_and_unconfirmed_never_false_or_zero",
  "legacy_axis_classification": [
    {"axis_id":"portability","classification":"split_into_subaxes","replacement":["body_weight_kg","weight_measurement_scope","carry_handle","carry_strap","folded_bounding_box_volume_l"],"reason":"重量、携行補助、折りたたみ外形は異なる事実であり、単一の主観値にしない"},
    {"axis_id":"train_fitness","classification":"editorial_only","replacement":["train_transport_burden","station_space_fit","folding_independence"],"reason":"利用場面への適合はraw factではなく、固定ルーブリックと人間承認を要する"},
    {"axis_id":"maneuverability","classification":"requires_third_party_measurement","replacement":["wheel_count","wheel_diameter","tire_type","suspension","maneuverability_evidence"],"reason":"公式機構や押しやすさ訴求だけでは小回り、段差、直進性を測れない"},
    {"axis_id":"one_operator_fitness","classification":"split_into_subaxes","replacement":["verified_one_hand_operation","required_fold_actions","requires_bending","requires_seat_removal","folded_lock","fold_with_seat_attached"],"reason":"一人操作を構成する明示事実へ分解し、重量を再加点しない"},
    {"axis_id":"folding_ease","classification":"deprecate","replacement":["one_hand_fold_explicit","one_hand_unfold_explicit","fold_step_count","requires_two_hands","requires_bending","requires_seat_removal","self_standing_explicit","standing_orientation","folded_lock","fold_with_seat_attached"],"reason":"主観的なraw featureであり、明示された操作事実に置き換える"},
    {"axis_id":"basket_capacity","classification":"unscorable_with_current_evidence","replacement":["basket_max_load_kg","basket_volume_l","basket_dimensions","basket_access","basket_opening","basket_measurement_scope"],"reason":"kgとLは相互変換できず、5商品共通の単一尺度がない"}
  ],
  "field_layers": [
    {"field_id":"body_weight_kg","comparison_layer":"raw","value_type":"number_or_null","unit":"kg","evidence_requirement":"official_spec","unknown_rule":"null"},
    {"field_id":"weight_measurement_scope","comparison_layer":"raw","value_type":"enum_or_null","allowed_values":["frame_and_seat","excluding_accessories","including_standard_accessories","manufacturer_stated_unspecified","unknown"],"unknown_rule":"unknown"},
    {"field_id":"weight_is_approximate","comparison_layer":"raw","value_type":"boolean_or_null","unknown_rule":"null"},
    {"field_id":"unfolded_width_mm","comparison_layer":"raw","value_type":"number_or_null","unit":"mm","unknown_rule":"null"},
    {"field_id":"unfolded_depth_mm","comparison_layer":"raw","value_type":"number_or_null","unit":"mm","unknown_rule":"null"},
    {"field_id":"unfolded_height_mm","comparison_layer":"raw","value_type":"number_or_null","unit":"mm","unknown_rule":"null"},
    {"field_id":"folded_width_mm","comparison_layer":"raw","value_type":"number_or_null","unit":"mm","unknown_rule":"null"},
    {"field_id":"folded_depth_mm","comparison_layer":"raw","value_type":"number_or_null","unit":"mm","unknown_rule":"null"},
    {"field_id":"folded_height_mm","comparison_layer":"raw","value_type":"number_or_null","unit":"mm","unknown_rule":"null"},
    {"field_id":"folded_dimension_orientation","comparison_layer":"raw","value_type":"enum_or_text_or_null","unknown_rule":"null"},
    {"field_id":"target_age_min_months","comparison_layer":"raw","value_type":"number_or_null","unit":"months","unknown_rule":"null"},
    {"field_id":"target_age_max_months","comparison_layer":"raw","value_type":"number_or_null","unit":"months","unknown_rule":"null"},
    {"field_id":"max_child_weight_kg","comparison_layer":"raw","value_type":"number_or_null","unit":"kg","unknown_rule":"null"},
    {"field_id":"one_hand_fold_explicit","comparison_layer":"raw","value_type":"boolean_or_null","unknown_rule":"null_not_false"},
    {"field_id":"one_hand_unfold_explicit","comparison_layer":"raw","value_type":"boolean_or_null","unknown_rule":"null_not_false"},
    {"field_id":"fold_step_count","comparison_layer":"raw","value_type":"integer_or_null","unknown_rule":"null"},
    {"field_id":"requires_two_hands","comparison_layer":"raw","value_type":"boolean_or_null","unknown_rule":"null_not_false"},
    {"field_id":"requires_bending","comparison_layer":"raw","value_type":"boolean_or_null","unknown_rule":"null_not_false"},
    {"field_id":"requires_seat_removal","comparison_layer":"raw","value_type":"boolean_or_null","unknown_rule":"null_not_false"},
    {"field_id":"self_standing_explicit","comparison_layer":"raw","value_type":"boolean_or_null","unknown_rule":"null_not_false"},
    {"field_id":"standing_orientation","comparison_layer":"raw","value_type":"enum_or_text_or_null","unknown_rule":"null"},
    {"field_id":"carry_handle","comparison_layer":"raw","value_type":"boolean_or_null","unknown_rule":"null_not_false"},
    {"field_id":"carry_strap","comparison_layer":"raw","value_type":"boolean_or_null","unknown_rule":"null_not_false"},
    {"field_id":"folded_lock","comparison_layer":"raw","value_type":"boolean_or_null","unknown_rule":"null_not_false"},
    {"field_id":"fold_with_seat_attached","comparison_layer":"raw","value_type":"boolean_or_null","unknown_rule":"null_not_false"},
    {"field_id":"basket_max_load_kg","comparison_layer":"raw","value_type":"number_or_null","unit":"kg","unknown_rule":"null"},
    {"field_id":"basket_volume_l","comparison_layer":"raw","value_type":"number_or_null","unit":"L","unknown_rule":"null"},
    {"field_id":"basket_dimensions","comparison_layer":"raw","value_type":"dimensions_or_null","unit":"mm","unknown_rule":"null"},
    {"field_id":"basket_access","comparison_layer":"raw","value_type":"enum_or_text_or_null","unknown_rule":"null"},
    {"field_id":"basket_opening","comparison_layer":"raw","value_type":"dimensions_or_text_or_null","unknown_rule":"null"},
    {"field_id":"basket_measurement_scope","comparison_layer":"raw","value_type":"text_or_null","unknown_rule":"null"},
    {"field_id":"seat_direction","comparison_layer":"raw","value_type":"enum_or_null","allowed_values":["parent_facing","world_facing","reversible","unknown"],"unknown_rule":"unknown"},
    {"field_id":"wheel_count","comparison_layer":"raw","value_type":"integer_or_null","unknown_rule":"null"},
    {"field_id":"wheel_diameter","comparison_layer":"raw","value_type":"number_or_range_or_null","unit":"mm","unknown_rule":"null"},
    {"field_id":"tire_type","comparison_layer":"raw","value_type":"enum_or_text_or_null","unknown_rule":"null"},
    {"field_id":"suspension","comparison_layer":"raw","value_type":"enum_or_text_or_null","unknown_rule":"null"},
    {"field_id":"handle_height_adjustment","comparison_layer":"raw","value_type":"boolean_or_range_or_null","unknown_rule":"null_not_false"},
    {"field_id":"travel_system_compatibility","comparison_layer":"raw","value_type":"structured_or_null","unknown_rule":"null"},
    {"field_id":"manufacturer_maneuverability_claim","comparison_layer":"raw","value_type":"text_or_null","claim_class":"manufacturer_claim","score_eligible":false,"unknown_rule":"null"},
    {"field_id":"folded_bounding_box_volume_l","comparison_layer":"derived","value_type":"number_or_null","unit":"L","formula":"folded_width_mm * folded_depth_mm * folded_height_mm / 1000000","semantic_limit":"axis-aligned bounding-box proxy; not actual occupied volume"},
    {"field_id":"folded_floor_footprint_cm2","comparison_layer":"derived","value_type":"number_or_null","unit":"cm2","formula":"standing-base dimensions in mm multiplied and divided by 100","precondition":"standing orientation and base axes are explicit"},
    {"field_id":"verified_one_hand_operation","comparison_layer":"derived","value_type":"true_false_unknown","formula":"true only when fold and unfold are both explicitly true; missing evidence stays unknown"},
    {"field_id":"verified_self_standing","comparison_layer":"derived","value_type":"true_false_unknown","formula":"copy explicit self-standing state; no statement stays unknown"},
    {"field_id":"carry_assistance_level","comparison_layer":"derived","value_type":"enum","formula":"both, handle_only, strap_only, none_explicit, or unknown from explicit handle/strap facts"},
    {"field_id":"required_fold_actions","comparison_layer":"derived","value_type":"structured_or_null","formula":"manufacturer step count plus separately reported seat-removal/two-hand/bending requirements; never invent a summed count"},
    {"field_id":"target_age_eligibility","comparison_layer":"derived","value_type":"eligibility_state","formula":"deterministic scenario gate"},
    {"field_id":"specification_completeness","comparison_layer":"derived","value_type":"ratio","formula":"confirmed applicable required raw facts divided by applicable required raw facts","performance_score":false},
    {"field_id":"weight_comparability_status","comparison_layer":"derived","value_type":"enum","allowed_values":["full","partial","unknown","not_applicable"],"formula":"scope equality and scope certainty"},
    {"field_id":"train_transport_burden","comparison_layer":"editorial","human_approval_required":true},
    {"field_id":"station_space_fit","comparison_layer":"editorial","human_approval_required":true},
    {"field_id":"folding_independence","comparison_layer":"editorial","human_approval_required":true},
    {"field_id":"one_operator_support","comparison_layer":"editorial","human_approval_required":true},
    {"field_id":"maneuverability_evidence","comparison_layer":"editorial","human_approval_required":true,"third_party_measurement_required":true},
    {"field_id":"train_commute_suitability","comparison_layer":"editorial","human_approval_required":true,"real_product_generation_prohibited":true}
  ]
}
