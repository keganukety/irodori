{
  "schema_version":"1.0.0","proposal_id":"stroller-train-normalization-v1","status":"proposed",
  "comparison_layers":["raw","derived","editorial"],"comparability_statuses":["full","partial","unknown","not_applicable"],
  "measurement_scopes":["frame_and_seat","excluding_accessories","including_standard_accessories","manufacturer_stated_unspecified","unknown"],
  "precision_statuses":["exact_as_stated","approximate_as_stated","range_as_stated","unknown"],
  "allowed_unit_conversions":[{"dimension":"mass","from":"g","to":"kg","formula":"g / 1000"},{"dimension":"mass","from":"kg","to":"g","formula":"kg * 1000"},{"dimension":"length","from":"cm","to":"mm","formula":"cm * 10"},{"dimension":"length","from":"mm","to":"cm","formula":"mm / 10"},{"dimension":"volume","from":"mL","to":"L","formula":"mL / 1000"},{"dimension":"volume","from":"L","to":"mL","formula":"L * 1000"},{"dimension":"area","from":"mm2","to":"cm2","formula":"mm2 / 100"}],
  "forbidden_unit_conversions":[{"from_dimension":"mass","to_dimension":"volume","examples":["kg_to_L","g_to_mL"],"reason":"density is unknown"},{"from_dimension":"volume","to_dimension":"mass","examples":["L_to_kg","mL_to_g"],"reason":"density is unknown"}],
  "basket_rules":{"separate_fields":["basket_max_load_kg","basket_volume_l","basket_dimensions","basket_access","basket_opening","basket_measurement_scope"],"single_capacity_score_allowed":false,"cross_unit_ranking_allowed":false,"assumed_density_allowed":false,"different_manufacturer_test_scope_equivalence_allowed":false},
  "weight_rules":{"required_fields":["body_weight_kg","weight_measurement_scope","weight_is_approximate"],"full_comparability":"same known measurement_scope and compatible included configuration","partial_comparability":"different known scopes or different explicitly excluded standard accessories","unknown_comparability":"either scope is manufacturer_stated_unspecified or unknown","approximate_rule":"preserve approximate status; do not imply precision beyond the manufacturer's wording","lightest_configuration_rule":"do not select a minimum configuration unless that configuration is the scenario-standard configuration"},
  "dimension_rules":{"orientation_required_for_floor_footprint":true,"folded_bounding_box_formula":"width_mm * depth_mm * height_mm / 1000000","folded_bounding_box_unit":"L","folded_bounding_box_label":"axis-aligned folded bounding-box volume proxy","forbidden_label":"actual occupied volume","variable_configuration_rule":"back-facing, parent-facing, world-facing, handle-height, and range conditions remain separate"},
  "folding_rules":{"subjective_raw_axis_forbidden":"folding_ease","fields":["one_hand_fold_explicit","one_hand_unfold_explicit","fold_step_count","requires_two_hands","requires_bending","requires_seat_removal","self_standing_explicit","standing_orientation","carry_handle","carry_strap","folded_lock","fold_with_seat_attached"],"one_hand_true_rule":"true only when the manufacturer explicitly states the corresponding fold or unfold operation","no_statement_rule":"null with evidence_status unconfirmed; never false","visual_inference_allowed":false},
  "claim_rules":{"manufacturer_claim_objective_promotion_allowed":false,"maneuverability_from_mechanism_allowed":false,"maneuverability_required_evidence":["standardized third-party turning-radius measurement","standardized step-obstacle measurement","standardized straight-line tracking measurement"],"mechanism_facts_preserved":["wheel_count","wheel_diameter","tire_type","suspension","auto_four_wheel_mechanism"]},
  "conflict_rules":{"required_or_critical":"on_hold","optional":"exclude_axis","unknown_is_zero":false,"false_requires_explicit_evidence":true},
  "identity_rules":{"generation_code_target_field":"generation_code","promote_generation_code_to_model_year":false,"promote_generation_code_to_model_number":false},
  "manual_consent_gate":{"allowed_states":["skipped_terms_acceptance_required","user_provided_manual_pending","human_download_required"],"ai_terms_acceptance_allowed":false,"unconfirmed_manual_axes_rule":"keep null until a human lawfully obtains and provides the manual"}
}
